{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["es6", "DOM"],

    "module": "ESNext",
    "rootDir": ".",
    "moduleResolution": "node10",
    "resolveJsonModule": true,
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "server/**/*.ts"],
  "exclude": ["node_modules"]
}
