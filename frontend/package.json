{
  "name": "mytranscendence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npx esbuild src/main.ts --bundle --outfile=dist/main.js --minify && npx tailwindcss -i ./src/style.css -o ./dist/output.css --minify",
    "dev": "concurrently \"esbuild src/main.ts --bundle --outfile=dist/main.js --watch\" \"npx @tailwindcss/cli -i ./src/style.css -o ./dist/output.css --watch\" \"live-server --port=3000 --host=0.0.0.0 --no-browser --mount=/dist:dist\"",
    "prod": "live-server --port=3000 --host=0.0.0.0 --no-browser --mount=/dist:dist",
    "start": "npm run dev"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@tailwindcss/cli": "^4.0.15",
    "@tailwindcss/postcss": "^4.0.15",
    "axios": "^1.9.0",
    "concurrently": "^8.2.2",
    "fastify": "^5.3.2",
    "jwt-decode": "^4.0.0",
    "live-server": "^1.2.2",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.2",
    "typescript": "^5.8.3"
  }
}
