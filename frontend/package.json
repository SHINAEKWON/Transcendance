{
  "name": "mytranscendence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsc --watch\" \"npx @tailwindcss/cli -i ./src/style.css -o ./dist/output.css --watch\" \"live-server --port=3000 --host=0.0.0.0 --no-browser --mount=/dist:dist\"",
    "prod": "live-server --port=3000 --host=0.0.0.0 --no-browser --mount=/dist:dist",
    "build": "tsc && npx tailwindcss -i ./src/style.css -o ./dist/output.css --minify --mount=/dist:dist",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@tailwindcss/cli": "^4.0.15",
    "@tailwindcss/postcss": "^4.0.0"
  }
}
