{
  "name": "mytranscendence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsc --watch\" \"npx tailwindcss -i ./src/style.css -o ./dist/output.css --watch\" \"live-server --port=3000 --host=0.0.0.0 --no-browser --mount=/dist:dist\"",
    "build": "tsc && npx tailwindcss -i ./src/style.css -o ./dist/output.css --minify",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.11.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  },
  "main": "postcss.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
